{
  "name": "formtrap-dm",
  "version": "1.0.0",
  "private": true,
  "description": "FormTrap-DM: data mining on contact-form spam, with the honeypot form that uses the result",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:open": "node tools/dev.mjs --open",
    "dev:check": "node tools/dev.mjs --smoke --no-import",
    "stop": "node tools/dev.mjs --stop",
    "setup": "php software/setup_database.php",
    "import": "php software/cron/import_dataset.php",
    "test": "php software/test.php",
    "algorithms": "python -m algorithms.selftest",
    "data": "python src/prepare_dataset.py",
    "notebook": "python tools/make_notebook.py && python tools/sync_artifacts.py",
    "check": "python tools/check_paper.py && python tools/check_py310.py",
    "paper": "python tools/check_paper.py && python tools/build_paper.py",
    "release": "python tools/make_release.py",
    "build": "npm run data && npm run notebook && npm run check && npm run paper && npm run release"
  }
}
